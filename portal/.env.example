# Supabase project (Settings -> API). The anon key is public by design.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# RevenueCat Web Billing public API key (Apps & providers -> Web Billing app).
# Leave empty to fall back to the Web Purchase Link.
VITE_REVENUECAT_WEB_KEY=
# Optional: RevenueCat Web Purchase Link base (https://pay.rev.cat/<token>)
VITE_REVENUECAT_PURCHASE_LINK=
# Download links shown on the home page.
VITE_DOWNLOAD_MAC=https://github.com/AkbarshohAbdurashidov/winter/releases/latest
VITE_DOWNLOAD_WINDOWS=https://github.com/AkbarshohAbdurashidov/winter/releases/latest
