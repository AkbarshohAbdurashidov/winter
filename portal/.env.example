# Firebase console -> Project settings -> Your apps -> Web app config (public values).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project>
VITE_FIREBASE_APP_ID=
# The `app` Cloud Function URL (printed by `firebase deploy`).
VITE_API_URL=https://europe-west1-<project>.cloudfunctions.net/app
# true = use the local emulators (firebase emulators:start).
VITE_USE_EMULATORS=false
# Download links shown on the home page.
VITE_DOWNLOAD_MAC=/download/mac
VITE_DOWNLOAD_WINDOWS=/download/windows
